<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while the process starts, before Flutter's first frame. Plum so the
     handoff to SplashView is seamless rather than a white flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_plum" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
